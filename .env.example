# Stytch public token for the Connected Apps project kbdb also verifies
# against. Use the Test project's public token for local dev; set
# separately per Cloudflare Pages environment (Production vs. Preview) in
# the dashboard for deployed builds.
PUBLIC_STYTCH_PUBLIC_TOKEN=

# client_id of this app's first_party_public Connected App client,
# registered in the same Stytch project as PUBLIC_STYTCH_PUBLIC_TOKEN.
PUBLIC_STYTCH_CLIENT_ID=

# Base path of the kbdb REST API, e.g. http://localhost:8080 for local dev.
PUBLIC_KBDB_API_BASE_PATH=
